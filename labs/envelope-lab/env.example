# Copy to env.sh and source before trials, or export inline.
#
# default solo = GPU 1; toggle dual for turbo (both GPUs)
export ENVELOPE_MODE=solo
export ENVELOPE_AI_GPU=1
export ENVELOPE_TRAIN_GPU=0
export ENVELOPE_CACHE=/vault/ailab/envelope-lab/cache
export ENVELOPE_RUNS=/vault/ailab/envelope-lab/runs
export ENVELOPE_TIME_BUDGET=300
